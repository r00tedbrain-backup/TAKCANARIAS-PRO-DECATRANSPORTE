# Copiar a .env y rellenar. El fichero .env no se sube al repositorio.

# Base de datos del área de alumnos. En el VPS la sirve su propio contenedor,
# separado de la del DeCA.
DATABASE_URL=postgres://takcanarias:CAMBIAR@localhost:5432/takcanarias

# Dirección pública de la web, sin barra final.
BETTER_AUTH_URL=https://nueva.takcanarias.es
NEXT_PUBLIC_APP_URL=https://nueva.takcanarias.es

# Secreto de sesión. Generar uno propio y no reutilizarlo entre entornos:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=CAMBIAR

# Registro de alumnos. Se mantiene cerrado hasta que la titular facilite
# razón social y NIF y apruebe los textos legales: parte del alumnado es
# menor de edad y no se deben guardar sus datos sin esa cobertura.
AREA_ALUMNO_REGISTRO_ABIERTO=0

# Envío de correo (Resend). Necesario para verificar cuentas y para el
# restablecimiento de contraseña. Se verifica un SUBDOMINIO en Resend
# (avisos.takcanarias.es) para no tocar el registro SPF del correo del centro.
RESEND_API_KEY=CAMBIAR
EMAIL_REMITENTE=Takcanarias <no-responder@avisos.takcanarias.es>
